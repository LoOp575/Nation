# Supabase project URL and publishable key.
# Copy this file to .env.local and fill values from the National Pulse Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key used by ingestion routes. Keep it private.
# NEVER prefix a secret/service-role key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Long random bearer secret used to authorize the private ingestion endpoint.
NATIONAL_PULSE_INGESTION_SECRET=

# Optional server-only BPS WebAPI key. Register the National Pulse application with BPS first.
# Never expose this key through NEXT_PUBLIC_* variables.
BPS_API_KEY=
